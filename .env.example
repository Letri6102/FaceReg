# ===== FaceReg - cấu hình. Sao chép thành file .env rồi chỉnh sửa =====

# BẮT BUỘC đổi: mã đăng nhập trang quản trị / gọi API admin
ADMIN_TOKEN=change-me

# Thư mục dữ liệu (CSDL SQLite, ảnh đăng ký, ảnh check-in)
DATA_DIR=data
MODEL_ROOT=models

# Domain được phép gọi API từ trình duyệt (vd trang thi MOOC nhúng monitor.js), cách nhau dấu phẩy
CORS_ORIGINS=

# Sau khi check-in ĐẠT sẽ chuyển tới URL này. Biến: {code} {exam} {token} {checkin_id}
# Vd: CHECKIN_SUCCESS_URL=https://mooc.example.edu.vn/exam/start?sbd={code}&exam={exam}&ftoken={token}
CHECKIN_SUCCESS_URL=

# ----- Mô hình nhận diện -----
# Gói InsightFace dùng cho phát hiện mặt + mô hình nhận diện chính
MODEL_NAME=buffalo_l
DET_SIZE=640
DET_THRESH=0.5
USE_GPU=false

# Mô hình nhận diện bổ sung để GỘP ĐIỂM (tùy chọn), cách nhau dấu phẩy. Dạng:
#   adaface:<file.onnx>       (xuất bằng scripts/export_adaface_onnx.py)
#   insightface:<file.onnx>   (vd glintr100.onnx trong gói antelopev2)
# EXTRA_MODELS=adaface:models/adaface/adaface_ir101_webface12m.onnx
EXTRA_MODELS=

# Trọng số gộp theo TÊN mô hình (tên file không đuôi; mô hình chính = MODEL_NAME). Trống = bằng nhau.
# Trọng số 0 = không dùng mô hình đó (vd chỉ dùng AdaFace: buffalo_l:0)
# FUSION_WEIGHTS=buffalo_l:0.5,adaface_ir101_webface12m:0.5
FUSION_WEIGHTS=

# Trích đặc trưng trên cả ảnh và ảnh lật ngang rồi cộng lại (chính xác hơn một chút, chậm gấp đôi ở bước này)
FLIP_TTA=true

# ----- Ngưỡng điểm (cosine, hoặc trung bình có trọng số khi gộp nhiều mô hình) -----
# HÃY HIỆU CHỈNH bằng scripts/calibrate_threshold.py, và chạy lại mỗi khi đổi mô hình / trọng số / FLIP_TTA
# >= ACCEPT: tự động đạt | < REJECT: không đạt | ở giữa: giám thị duyệt
THRESHOLD_ACCEPT=0.45
THRESHOLD_REJECT=0.28

# ----- Kiểm tra chất lượng ảnh 4x6 khi đăng ký -----
ENROLL_MIN_FACE_PX=112
ENROLL_MAX_YAW=15
ENROLL_MAX_PITCH=15
ENROLL_MIN_SHARPNESS=40
ENROLL_MIN_BRIGHTNESS=50
ENROLL_MAX_BRIGHTNESS=215
ENROLL_MIN_DET_SCORE=0.6

# ----- Check-in & thử thách chủ động -----
CHECKIN_MIN_FACE_PX=90
CHALLENGE_TURNS=3
CHALLENGE_HOLD_FRAMES=2
YAW_TURN_RATIO=0.25
YAW_FRONTAL_RATIO=0.12
PITCH_UP_DELTA=0.10
PITCH_CENTER_TOLERANCE=0.08
# Đặt true nếu camera/driver tự lật ảnh (người thi quay trái mà hệ thống báo "ngược hướng")
CAMERA_MIRRORED=false
SESSION_TTL_SECONDS=120
SESSION_MAX_FRAMES=300
IDENTITY_CONSISTENCY_MIN=0.35
MULTI_FACE_AREA_RATIO=0.25

# ----- Liveness thụ động (tùy chọn, xem scripts/export_antispoof_onnx.py) -----
# ANTISPOOF_MODELS=models/anti_spoof/2.7_80x80_MiniFASNetV2.onnx,models/anti_spoof/4_0_0_80x80_MiniFASNetV1SE.onnx
ANTISPOOF_MODELS=
ANTISPOOF_THRESHOLD=0.8
ANTISPOOF_INPUT_SCALE=1.0
ANTISPOOF_REAL_INDEX=1

# ----- Đăng ký dần dần: lưu thêm mẫu webcam sau khi xác thực chắc chắn -----
PROGRESSIVE_ENROLL=true
AUTO_TEMPLATE_MIN_SCORE=0.55
MAX_LIVE_TEMPLATES=5

# ----- Giám sát trong giờ thi -----
MONITOR_MIN_INTERVAL_SECONDS=3
